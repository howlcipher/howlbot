(cli_app
  (let (command "")
    (let (user_id "")
      (let (roles "")
        (let (approved "false")
          (do
            (for arg (cli_args)
              (let (parts (str_split arg "="))
                (let (key "")
                  (let (val "")
                    (let (i 0)
                      (do
                        (for p parts
                          (do
                            (if (= i 0) (set key p))
                            (if (= i 1) (set val p))
                            (set i (+ i 1))))
                        (if (= key "command") (set command val))
                        (if (= key "user_id") (set user_id val))
                        (if (= key "roles") (set roles val))
                        (if (= key "approved") (set approved val))
                      )
                    )
                  )
                )
              )
            )

            (let (decision "DENY")
              (let (decision_reason "unknown command")
                (let (action "none")
                  (let (action_target "")
                    (do
                      (let (has_admin "false")
                        (let (has_maintainer "false")
                          (do
                            (for role (str_split roles ",")
                              (do
                                (if (= role "admin") (set has_admin "true"))
                                (if (= role "maintainer") (set has_maintainer "true"))
                              )
                            )

                            (if (= command "status")
                              (do
                                (set decision "ALLOW")
                                (set decision_reason "status is read-only")
                                (set action "send_message")
                                (set action_target "System is operational.")
                              )
                            )
                            (if (= command "policy")
                              (do
                                (set decision "ALLOW")
                                (set decision_reason "policy is read-only")
                                (set action "send_message")
                                (set action_target "Policy: Deterministic HowlFrame")
                              )
                            )
                            (if (= command "history")
                              (do
                                (set decision "ALLOW")
                                (set decision_reason "history is read-only")
                                (set action "show_history")
                              )
                            )
                            (if (= command "repo_status")
                              (if (or (= has_admin "true") (= has_maintainer "true"))
                                (do
                                  (set decision "ALLOW")
                                  (set decision_reason "authorized for repo operations")
                                  (set action "send_message")
                                  (set action_target "Repo is healthy.")
                                )
                                (do
                                  (set decision "DENY")
                                  (set decision_reason "missing required role")
                                )
                              )
                            )
                            (if (= command "repo_release")
                              (if (= has_admin "true")
                                (if (= approved "true")
                                  (do
                                    (set decision "ALLOW")
                                    (set decision_reason "release approved")
                                    (set action "send_message")
                                    (set action_target "Release executed.")
                                  )
                                  (do
                                    (set decision "REQUIRE_APPROVAL")
                                    (set decision_reason "release requires explicit approval")
                                  )
                                )
                                (do
                                  (set decision "DENY")
                                  (set decision_reason "only admins can release")
                                )
                              )
                            )

                            (print "{")
                            (print (str_join (list "  \"decision\": \"" decision "\",") ""))
                            (print (str_join (list "  \"reason\": \"" decision_reason "\",") ""))
                            (print (str_join (list "  \"action\": \"" action "\",") ""))
                            (print (str_join (list "  \"action_target\": \"" action_target "\"") ""))
                            (print "}")
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
